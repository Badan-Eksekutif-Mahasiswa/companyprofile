# Salin ke .env.local lalu isi sesuai kebutuhan.

# URL publik website (dipakai untuk metadata / OG image).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ID video YouTube company profile BEM UI (bagian setelah "watch?v=").
# Default: R5XbD1vjXlg (company profile BEM UI 2026).
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=R5XbD1vjXlg
