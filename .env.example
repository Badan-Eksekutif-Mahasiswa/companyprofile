# Salin ke .env.local lalu isi sesuai kebutuhan. Jangan commit .env.local.
# Railway: isi di service Variables, lalu deploy dari main.
# NEXT_PUBLIC_SITE_URL wajib berupa URL publik saat Docker build.

# Domain situs (link share, OG, canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ID video YouTube company profile BEM UI (bagian setelah "watch?v="). Default: R5XbD1vjXlg
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=R5XbD1vjXlg

# API publik CMS SIT (profil, birdep, proker, dan News), tanpa slash di akhir.
SIT_API_URL=https://sitbemui.com/api/website/v1

# Cadangan bila SIT_API_URL kosong -- Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2: URL publik bucket, tanpa slash di akhir.
NEXT_PUBLIC_R2_PUBLIC_URL=

# Branch main tidak menyertakan data demo.
ENABLE_DEMO_DATA=false

# --- Hanya server (JANGAN pakai awalan NEXT_PUBLIC_) ---
NEWS_PREVIEW_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
