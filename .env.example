# Salin ke .env.local lalu isi. Jangan commit .env.local.

# API CMS SIT (sumber utama News). Isi bila sudah tersedia, tanpa slash di akhir.
SIT_API_URL=https://sit.contoh.id/api/website/v1

# Cadangan bila SIT_API_URL kosong -- Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# anon (public) key. Aman di browser karena akses dibatasi Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2: URL publik bucket (custom domain atau r2.dev), tanpa slash di akhir.
NEXT_PUBLIC_R2_PUBLIC_URL=https://media.contoh.id

# Domain situs (link share, OG, canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Hanya server (JANGAN pakai awalan NEXT_PUBLIC_) ---
# Pratinjau artikel draft: token rahasia (string acak panjang) + service role key Supabase.
NEWS_PREVIEW_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=
